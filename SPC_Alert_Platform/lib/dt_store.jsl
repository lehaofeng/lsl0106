Names Default To Here(1);

SPC_BASE_DIR = Get Directory("JMP Home") || "SPC_Alert_Platform/";
SPC_DATA_DIR = SPC_BASE_DIR || "data/";

SPCEnsureDirectory = Function({dirPath},
	If(!Directory Exists(dirPath),
		Create Directory(dirPath)
	);
);

SPCDataPath = Function({fileName},
	SPCEnsureDirectory(SPC_BASE_DIR);
	SPCEnsureDirectory(SPC_DATA_DIR);
	SPC_DATA_DIR || fileName;
);

SPCEnsureColumn = Function({dt, colName, colType, colFormat},
	If(Is Missing(Column(dt, colName)),
		New Column(dt, colName, colType, colFormat)
	);
);

SPCEnsureTable = Function({tableName, columns, rebuild=0},
	localPath = SPCDataPath(tableName || ".jmp");
	If(rebuild & File Exists(localPath),
		Delete File(localPath)
	);
	If(File Exists(localPath),
		dt = Open(localPath, Private);
	,
		dt = New Table(tableName, Invisible);
	);
	For(i = 1, i <= N Items(columns), i++,
		colSpec = columns[i];
		SPCEnsureColumn(dt, colSpec[1], colSpec[2], colSpec[3]);
	);
	If(Is Missing(Column(dt, "lock_flag")),
		New Column(dt, "lock_flag", Numeric, "Continuous");
		Column(dt, "lock_flag") << Set Property("Notes", "0=unlocked,1=locked");
	);
	dt << Save(localPath);
	Close(dt, No Save);
);

SPCLockTable = Function({tableName},
	localPath = SPCDataPath(tableName || ".jmp");
	dt = Open(localPath, Private);
	If(N Rows(dt) == 0,
		dt << Add Rows(1);
	);
	If(Column(dt, "lock_flag")[1] == 1,
		Throw("Table is locked: " || tableName)
	);
	Column(dt, "lock_flag")[1] = 1;
	dt << Save(localPath);
	Close(dt, No Save);
);

SPCUnlockTable = Function({tableName},
	localPath = SPCDataPath(tableName || ".jmp");
	If(!File Exists(localPath), Return());
	dt = Open(localPath, Private);
	If(N Rows(dt) == 0,
		dt << Add Rows(1);
	);
	Column(dt, "lock_flag")[1] = 0;
	dt << Save(localPath);
	Close(dt, No Save);
);

