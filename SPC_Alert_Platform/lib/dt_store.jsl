SPCSeedSampleData = Function({},
	localPath = SPCDataPath("DB_CONN.jmp");
	dt = Open(localPath, Private);
	If(N Rows(dt) == 0,
		dt << Add Rows(1);
		Column(dt, "conn_name")[1] = "mysql_sample";
		Column(dt, "odbc_dsn")[1] = "mysql_spc";
		Column(dt, "conn_string")[1] = "Driver={MySQL ODBC 8.0 Driver};Server=localhost;Database=spc;";
		Column(dt, "query_template")[1] = "SELECT ts, line, machine, variable, value, subgroup_id, subgroup_index FROM spc_measurements WHERE ts > '{watermark}'";
		Column(dt, "incremental_mode")[1] = "TS";
		Column(dt, "watermark_value")[1] = "1970-01-01 00:00:00";
		Column(dt, "poll_seconds")[1] = 10;
		Column(dt, "is_active")[1] = 1;
	);
	dt << Save(localPath);
	Close(dt, No Save);
);
